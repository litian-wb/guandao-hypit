[
  {
    "frame": 0,
    "chars_per_second": 4.86,
    "text": "再往前一寸，丢掉的就是整车。"
  },
  {
    "frame": 148,
    "chars_per_second": 4.23,
    "text": "轮子停了，货物却还在往前。"
  },
  {
    "frame": 304,
    "chars_per_second": 4.06,
    "text": "可刚才，他还觉得自己走得太慢。"
  },
  {
    "frame": 496,
    "chars_per_second": 5.14,
    "text": "他要把这一车东西，送到山的另一边。"
  },
  {
    "frame": 671,
    "chars_per_second": 2.68,
    "text": "万物皆变，规律不变。"
  },
  {
    "frame": 850,
    "chars_per_second": 3.88,
    "text": "风会转，水会涨；重物仍向低处走。"
  },
  {
    "frame": 1051,
    "chars_per_second": 3.33,
    "text": "弱时观势，不是站着空等。"
  },
  {
    "frame": 1231,
    "chars_per_second": 4.65,
    "text": "他越用力，轮子反而越往后滑。"
  },
  {
    "frame": 1386,
    "chars_per_second": 5.61,
    "text": "不是再多使一点劲，就能走上去。"
  },
  {
    "frame": 1525,
    "chars_per_second": 3.59,
    "text": "看清坡度，也看看旁边那条缓路。"
  },
  {
    "frame": 1742,
    "chars_per_second": 3.61,
    "text": "换一条缓路，车终于越过了坡顶。"
  },
  {
    "frame": 1958,
    "chars_per_second": 3.82,
    "text": "盛时知止，难在一切都很顺。"
  },
  {
    "frame": 2131,
    "chars_per_second": 5.45,
    "text": "刚才需要推，现在却必须刹。"
  },
  {
    "frame": 2252,
    "chars_per_second": 3.86,
    "text": "车走得快，不全是你的本事。"
  },
  {
    "frame": 2423,
    "chars_per_second": 3.03,
    "text": "势来则乘，让条件替你省力。"
  },
  {
    "frame": 2641,
    "chars_per_second": 2.65,
    "text": "风向对了，他才把布面展开。"
  },
  {
    "frame": 2890,
    "chars_per_second": 4.53,
    "text": "不必一直硬推，也能稳稳往前。"
  },
  {
    "frame": 3049,
    "chars_per_second": 3.03,
    "text": "可风不会，一直替你推车。"
  },
  {
    "frame": 3247,
    "chars_per_second": 4.13,
    "text": "桥板松了，水也涨过了刻线。"
  },
  {
    "frame": 3407,
    "chars_per_second": 3.55,
    "text": "势尽则退，不是把这一程认输。"
  },
  {
    "frame": 3610,
    "chars_per_second": 3.22,
    "text": "退回平地，才留得住下一程。"
  },
  {
    "frame": 3815,
    "chars_per_second": 2.56,
    "text": "观道，不是为了算尽未来。"
  },
  {
    "frame": 4049,
    "chars_per_second": 3.63,
    "text": "地图上的捷径，眼前未必走得通。"
  },
  {
    "frame": 4264,
    "chars_per_second": 3.82,
    "text": "是为了在变化来临之前，"
  },
  {
    "frame": 4421,
    "chars_per_second": 5.31,
    "text": "先抬头看看，条件已经变了没有。"
  },
  {
    "frame": 4568,
    "chars_per_second": 4.54,
    "text": "再量一量，自己的车能走多宽的路。"
  },
  {
    "frame": 4753,
    "chars_per_second": 3.26,
    "text": "他没有再赌那最后一寸。"
  },
  {
    "frame": 4937,
    "chars_per_second": 4.73,
    "text": "多走一点路，整车东西却都还在。"
  },
  {
    "frame": 5102,
    "chars_per_second": 2.8,
    "text": "看懂自己该往哪里走。"
  },
  {
    "frame": 5295,
    "chars_per_second": 3.92,
    "text": "不是每条近路，都属于你。"
  }
]