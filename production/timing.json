{
  "duration": 90.8,
  "fps": 60,
  "events": [
    {
      "time": 0.016666666666666666,
      "title": "让你翻船的",
      "text": "让你翻船的，未必是风浪。",
      "id": "beat0"
    },
    {
      "time": 2.466666666666667,
      "title": "未必是风浪",
      "text": "也可能是那句：",
      "id": "beat1"
    },
    {
      "time": 5.066666666666666,
      "title": "再往前一点",
      "text": "“再往前一点，就能赢了。”",
      "id": "beat2"
    },
    {
      "time": 8.266666666666667,
      "title": "同一条河",
      "text": "同一条河，为什么有人进，有人退？",
      "id": "beat3"
    },
    {
      "time": 11.183333333333334,
      "title": "万物皆变",
      "text": "万物皆变，规律不变。",
      "id": "beat4"
    },
    {
      "time": 14.166666666666666,
      "title": "规律不变",
      "text": "变的是水势，不变的是进退的分寸。",
      "id": "beat5"
    },
    {
      "time": 17.516666666666666,
      "title": "风转 · 水落",
      "text": "风会转向，水有涨落。",
      "id": "beat6"
    },
    {
      "time": 20.516666666666666,
      "title": "弱时观势",
      "text": "弱时观势，不是站在岸边空等。",
      "id": "beat7"
    },
    {
      "time": 23.1,
      "title": "先别硬闯",
      "text": "船小的时候，别急着跟浪较劲。",
      "id": "beat8"
    },
    {
      "time": 25.416666666666668,
      "title": "先看水 · 再看风",
      "text": "看清哪里有力，哪里会把你卷回。",
      "id": "beat9"
    },
    {
      "time": 29.033333333333335,
      "title": "等方向清楚",
      "text": "方向清楚了，再把第一步迈出去。",
      "id": "beat10"
    },
    {
      "time": 32.63333333333333,
      "title": "盛时知止",
      "text": "盛时知止，不是突然胆小。",
      "id": "beat11"
    },
    {
      "time": 35.516666666666666,
      "title": "顺风 ≠ 永远加速",
      "text": "顺风时，别忘了借的是风。",
      "id": "beat12"
    },
    {
      "time": 37.53333333333333,
      "title": "浪尖之前 · 收帆",
      "text": "越接近浪尖，越要知道何时收帆。",
      "id": "beat13"
    },
    {
      "time": 40.38333333333333,
      "title": "势来则乘",
      "text": "势来则乘，让方向替你省力。",
      "id": "beat14"
    },
    {
      "time": 44.016666666666666,
      "title": "借势 · 不逞强",
      "text": "借的是势，不是把蛮力当本事。",
      "id": "beat15"
    },
    {
      "time": 48.166666666666664,
      "title": "势尽则退",
      "text": "势尽则退，别把退让看成失败。",
      "id": "beat16"
    },
    {
      "time": 50.81666666666667,
      "title": "风已转向",
      "text": "风已经变了，再用力，也回不到刚才。",
      "id": "beat17"
    },
    {
      "time": 54.11666666666667,
      "title": "再进 · 只是执拗",
      "text": "此刻再进，可能只是舍不得停下。",
      "id": "beat18"
    },
    {
      "time": 56.78333333333333,
      "title": "留住下一程",
      "text": "退一步，是把下一程的可能留下。",
      "id": "beat19"
    },
    {
      "time": 60.166666666666664,
      "title": "观道",
      "text": "所以，观道，",
      "id": "beat20"
    },
    {
      "time": 63.583333333333336,
      "title": "不算尽未来",
      "text": "不是为了算尽未来。",
      "id": "beat21"
    },
    {
      "time": 67.48333333333333,
      "title": "推演 ≠ 保证",
      "text": "你可以推演很多条路，却不能保证每阵风。",
      "id": "beat22"
    },
    {
      "time": 71.06666666666666,
      "title": "变化来临之前",
      "text": "是为了在变化来临之前，",
      "id": "beat23"
    },
    {
      "time": 73.68333333333334,
      "title": "认出第一道转向",
      "text": "认出水面第一道转向。",
      "id": "beat24"
    },
    {
      "time": 76.13333333333334,
      "title": "先调整自己",
      "text": "不等风浪推着你走，先调整自己。",
      "id": "beat25"
    },
    {
      "time": 79.21666666666667,
      "title": "不必赢过每场风",
      "text": "你不需要赢过每一场风。",
      "id": "beat26"
    },
    {
      "time": 82.28333333333333,
      "title": "看懂自己",
      "text": "你要看懂的，是自己。",
      "id": "beat27"
    },
    {
      "time": 85.03333333333333,
      "title": "该往哪里走",
      "text": "看懂自己该往哪里走。",
      "id": "beat28"
    },
    {
      "time": 88.25,
      "title": "进退 · 由你",
      "text": "这一次，进退，由你。",
      "id": "beat29"
    }
  ],
